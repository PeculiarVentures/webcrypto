{
  "name": "@peculiar/webcrypto",
  "version": "2.0.0",
  "description": "A WebCrypto Polyfill for NodeJS",
  "type": "module",
  "sideEffects": false,
  "files": [
    "build/",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeculiarVentures/webcrypto"
  },
  "keywords": [
    "webcrypto",
    "crypto",
    "sha",
    "rsa",
    "ec",
    "aes",
    "des",
    "hmac",
    "pbkdf2",
    "eddsa",
    "x25519",
    "ed25519",
    "x448",
    "ed448",
    "shake128",
    "shake256"
  ],
  "author": "PeculiarVentures",
  "contributors": [
    "Miroshin Stepan<microshine@mail.ru>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PeculiarVentures/webcrypto/issues"
  },
  "homepage": "https://github.com/PeculiarVentures/webcrypto#readme",
  "dependencies": {
    "@peculiar/utils": "^4.1.0"
  },
  "peerDependencies": {
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/json-schema": "^3.0.0",
    "webcrypto-core": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/json-schema": "^3.0.0",
    "@peculiar/webcrypto-test": "^2.0.0",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "webcrypto-core": "^2.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./package.json": "./package.json"
  }
}
